# Block direct access to sensitive files if the web root is the project folder (not ideal — prefer pointing the vhost to /public).
<IfModule mod_authz_core.c>
    <Files ".env">
        Require all denied
    </Files>
    <FilesMatch "(?i)^\.">
        Require all denied
    </FilesMatch>
    <FilesMatch "(?i)(^|/)(composer\.(json|lock)|package(-lock)?\.json|\.gitignore|artisan|phpunit\.xml(\.dist)?)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <Files ".env">
        Order allow,deny
        Deny from all
    </Files>
    <FilesMatch "(?i)^\.">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ /public/$1 [L,QSA]
